# ---------------------------------------------------------------------------
# SuperAI Assistant - configuration template. Copy to .env and fill in.
# NEVER commit the real .env file. This file contains placeholders only.
# On hosting platforms, set these as environment variables instead of using a file.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=put_your_botfather_token_here

# --- Human moderator (private ticket system) ------------------------------
# Numeric Telegram user IDs allowed to use moderator commands (comma-separated).
# Find yours by sending /id to the bot.
MODERATOR_USER_IDS=
# Where new tickets are delivered. Leave empty to use the FIRST moderator's private chat with the bot
# (that moderator must press Start in the bot once). For a private support group, use its negative ID.
SUPPORT_CHAT_ID=

# --- Direct "Contact Human Moderator" button ------------------------------
# Telegram username (with or without @). Leave empty/placeholder if not set yet.
# You can also change it later from Telegram with /setsupport @username (no redeploy needed).
SUPPORT_TELEGRAM_USERNAME=your_moderator_username

# --- Links ----------------------------------------------------------------
WEBSITE_URL=https://XRPFootball.com
REGISTER_URL=https://www.netmark.ai/xrp
# Pages the /kbrefresh command may read (comma-separated; only these hosts are ever fetched)
# KB_SOURCE_URLS=https://XRPFootball.com,https://www.netmark.ai/xrp,https://super.one/

# --- Database -------------------------------------------------------------
# Local development (default): a SQLite file
DATABASE_URL=sqlite:///data/superai.db
# Production (recommended on hosts with ephemeral disks):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- AI (optional; leave AI_PROVIDER=none for FAQ-only mode, which costs nothing) ---
AI_PROVIDER=none
# For any OpenAI-compatible provider set all of the following and AI_PROVIDER=openai_compatible:
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=put_your_provider_key_here
# AI_MODEL=model-name-from-your-provider
# Cost controls
AI_DAILY_LIMIT=300
AI_USER_DAILY_LIMIT=15
CACHE_TTL_SECONDS=86400

# --- Limits ---------------------------------------------------------------
RATE_LIMIT_MESSAGES=8
RATE_LIMIT_WINDOW_SECONDS=60
MAX_QUESTION_CHARS=800
MAX_TICKET_CHARS=3000
TICKET_LIMIT_PER_HOUR=3

# --- Webhook mode (optional; polling is used when WEBHOOK_URL is empty) ----
# WEBHOOK_URL=https://your-public-domain.example.com
# WEBHOOK_SECRET_TOKEN=generate_a_long_random_string_using_letters_digits_underscore_dash
# PORT=8080

LOG_LEVEL=INFO
